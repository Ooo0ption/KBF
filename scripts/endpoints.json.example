{
  "_README": "Copy this file to scripts/endpoints.json (gitignored) and fill in your endpoints. Each top-level key is a profile name you can pass via --endpoint <name>. CLI flags override per-field. Remove this _README entry — it's just documentation.",

  "openai-official": {
    "_": "Official OpenAI Responses API (recommended for gpt-5 / o-series).",
    "api_base": "https://api.openai.com/v1/responses",
    "api_key":  "sk-proj-...replace-with-your-key...",
    "protocol": "openai-responses"
  },

  "openai-chat-official": {
    "_": "Same vendor via the legacy Chat Completions endpoint.",
    "api_base": "https://api.openai.com/v1/chat/completions",
    "api_key":  "sk-proj-...replace-with-your-key...",
    "protocol": "openai-chat"
  },

  "anthropic-official": {
    "_": "Official Anthropic Messages API.",
    "api_base": "https://api.anthropic.com/v1/messages",
    "api_key":  "sk-ant-...replace-with-your-key...",
    "protocol": "anthropic-messages"
  },

  "openrouter": {
    "_": "OpenRouter, a multi-vendor relay.",
    "api_base": "https://openrouter.ai/api/v1/chat/completions",
    "api_key":  "sk-or-v1-...replace-with-your-key...",
    "protocol": "openai-chat"
  },

  "openai-via-env": {
    "_": "Same as openai-official but the key is read from an env var of your choice. Useful for secrets you don't want sitting in this file. Use `api_key_env` (NOT api_key).",
    "api_base": "https://api.openai.com/v1/responses",
    "api_key_env": "MY_PERSONAL_OPENAI_KEY",
    "protocol": "openai-responses"
  },

  "suspect-relay-A": {
    "_": "Example of auditing a third-party relay claiming to serve gpt-5.4. OpenAI-chat compatible.",
    "api_base": "https://relay-a.example.com/v1/chat/completions",
    "api_key":  "sk-relay-...",
    "protocol": "openai-chat"
  },

  "suspect-relay-B": {
    "_": "Same audit pattern for a different relay. Add as many as you want.",
    "api_base": "https://relay-b.example.com/v1/chat/completions",
    "api_key_env": "RELAY_B_KEY",
    "protocol": "openai-chat"
  }
}
